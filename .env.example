# ============================================================
# FlyRank Capstone — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- Application ---
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=flyrank
POSTGRES_PASSWORD=flyrank_secret_change_me
POSTGRES_DB=flyrank_billing
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://flyrank:flyrank_secret_change_me@postgres:5432/flyrank_billing

# --- Razorpay Test/Sandbox Credentials ---
# Obtain from: https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_TEST_KEY_SECRET

# --- Razorpay Webhook Secret ---
# Obtain from: Razorpay Dashboard > Account & Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# --- Pricing Constants (micro-INR per token) ---
# These are project-defined constants — do NOT change without updating EVIDENCE.md
PRICE_FRESH_INPUT_TOKEN_MICRO_INR=40
PRICE_CACHED_INPUT_TOKEN_MICRO_INR=10
PRICE_OUTPUT_TOKEN_MICRO_INR=160
PRICE_REASONING_TOKEN_MICRO_INR=160

# --- Budget Guard (micro-INR per call) ---
FREE_MAX_COST_PER_CALL_MICRO_INR=10000000
PRO_MAX_COST_PER_CALL_MICRO_INR=100000000
