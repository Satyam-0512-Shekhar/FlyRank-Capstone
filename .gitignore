# ============================================================
# FlyRank Capstone — Usage Metering & Billing Engine
# .gitignore — secrets and build artifacts MUST NOT be committed
# ============================================================

# --- Environment / Secrets (CRITICAL — never commit) ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/
.Python

# --- Pytest / Coverage ---
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.log
*.db
*.sqlite3
*.sqlite

# --- Alembic local ---
alembic/versions/*.pyc

# --- MyPy / Type checking ---
.mypy_cache/
.dmypy.json
dmypy.json

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Docker ---
*.dockerignore

# --- OS ---
.DS_Store
Thumbs.db
